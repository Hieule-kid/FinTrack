# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required by docker-compose; use a unique local-only password.
PGADMIN_DEFAULT_EMAIL=admin@local.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-unique-local-password

# ── Eureka / Config Service ────────────────────────────────────────────────────
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka123

# ── JWT (must be identical across all services) ───────────────────────────────
FINTRACK_JWT_SECRET=change-me-use-a-long-random-string-32-chars-min

# ── Gemini AI (planning-service) ──────────────────────────────────────────────
GEMINI_API_KEY=

# ── CORS: allowed frontend origin ─────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
