# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required by docker-compose; use a unique local-only password.
PGADMIN_DEFAULT_EMAIL=admin@local.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-unique-local-password

# ── Eureka / Config Service ────────────────────────────────────────────────────
# Must match the EUREKA_USERNAME/PASSWORD set on auth-service and
# planning-service (in their own repos) — they authenticate against this
# Eureka server's basic auth to register.
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka123
